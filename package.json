{
  "name": "tagum-food-finder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "biome format --write src validation/scripts package.json tsconfig.json next.config.ts vitest.config.ts biome.json",
    "format:check": "biome format src validation/scripts package.json tsconfig.json next.config.ts vitest.config.ts biome.json",
    "lint": "biome lint src validation/scripts next.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:osm": "tsx validation/scripts/audit-osm-snapshot.ts",
    "catalog:osm": "tsx validation/scripts/import-osm-catalog.ts",
    "catalog:overture": "tsx validation/scripts/import-overture-catalog.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local --level warning"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/postcss": "^4.3.3",
    "maplibre-gl": "^6.14.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.4",
    "supabase": "^2.120.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
