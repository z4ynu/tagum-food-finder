# Deployment identity is server-only and must match the selected Supabase project.
APP_ENVIRONMENT=local
APP_ORIGIN=http://127.0.0.1:3000
SUPABASE_PROJECT_REF=local

# Public Supabase values used by browser-safe clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values must never use the NEXT_PUBLIC_ prefix or enter browser code.
# Use only in narrowly scoped administrative jobs and protected server operations.
SUPABASE_SERVICE_ROLE_KEY=
SENTRY_DSN=
